{
  "name": "@arora19/recipe-ui-kit",
  "version": "0.1.0",
  "description": "Reusable StencilJS components for recipe discovery and weekly meal planning.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-ui-kit/recipe-ui-kit.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch",
    "generate": "stencil generate"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stencil/core": "^4.20.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "stencil",
    "web-components",
    "custom-elements",
    "recipe",
    "ui-kit"
  ]
}
