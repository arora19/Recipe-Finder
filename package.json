{
  "name": "recipe-platform-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/recipe-ui-kit",
    "packages/web-app"
  ],
  "scripts": {
    "dev:ui-kit": "npm run start --workspace=packages/recipe-ui-kit",
    "build:ui-kit": "npm run build --workspace=packages/recipe-ui-kit",
    "publish:ui-kit": "npm publish --workspace=packages/recipe-ui-kit",
    "dev:web": "npm run dev --workspace=packages/web-app",
    "build:web": "npm run build --workspace=packages/web-app"
  }
}
